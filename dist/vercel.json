{
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "framework": "static",
  "serverless": {
    "memory": 128
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
